# Copy this file to .env. Never commit .env or the token cache.

# Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback

# SoundCloud (https://soundcloud.com/you/apps)
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_REDIRECT_URI=http://127.0.0.1:8766/callback

# Apple Music (Developer portal)
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Path to the .p8 private key. Keep the actual key outside version control.
APPLE_MUSIC_PRIVATE_KEY_PATH=
APPLE_MUSIC_STOREFRONT=us
# A Music User Token generated by a MusicKit JS companion page or Apple app.
APPLE_MUSIC_USER_TOKEN=

# TIDAL is authenticated interactively by tidalapi's device/browser flow.

